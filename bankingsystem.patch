+using BankingSystem.Servicios;
+
+namespace BankingSystem.Tests;
+
+public class ServicioContrasenasTests
+{
+    [Fact]
+    public void Generar_ProduceSalesDistintasParaLaMismaContrasena()
+    {
+        var (hash1, sal1) = ServicioContrasenas.Generar("MiClave123!");
+        var (hash2, sal2) = ServicioContrasenas.Generar("MiClave123!");
+
+        Assert.NotEqual(sal1, sal2);
+        Assert.NotEqual(hash1, hash2);
+    }
+
+    [Fact]
+    public void Verificar_RetornaVerdadero_ConLaContrasenaCorrecta()
+    {
+        var (hash, sal) = ServicioContrasenas.Generar("MiClave123!");
+
+        Assert.True(ServicioContrasenas.Verificar("MiClave123!", hash, sal));
+    }
+
+    [Fact]
+    public void Verificar_RetornaFalso_ConLaContrasenaIncorrecta()
+    {
+        var (hash, sal) = ServicioContrasenas.Generar("MiClave123!");
+
+        Assert.False(ServicioContrasenas.Verificar("OtraClave", hash, sal));
+    }
+}
