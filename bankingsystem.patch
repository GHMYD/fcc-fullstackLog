+namespace BankingSystem.Interfaz;
+
+/// <summary>
+/// Utilidades de entrada/salida por consola: lectura de texto, números,
+/// contraseñas enmascaradas y mensajes con color.
+/// </summary>
+public static class ConsolaAyudante
+{
+    public static string LeerTexto(string etiqueta)
+    {
+        while (true)
+        {
+            Console.Write(etiqueta);
+            var valor = Console.ReadLine();
+            if (!string.IsNullOrWhiteSpace(valor))
+            {
+                return valor.Trim();
+            }
+            EscribirError("Este campo no puede estar vacío.");
+        }
+    }
+
+    public static string LeerContrasena(string etiqueta)
+    {
+        Console.Write(etiqueta);
+
+        if (Console.IsInputRedirected)
+        {
+            // No hay terminal interactiva (p. ej. entrada por tubería o en pruebas):
+            // no se puede enmascarar la escritura, así que se lee la línea tal cual.
+            return Console.ReadLine()?.Trim() ?? string.Empty;
+        }
+
+        var contrasena = string.Empty;
+        ConsoleKeyInfo tecla;
+
+        do
+        {
+            tecla = Console.ReadKey(intercept: true);
+
+            if (tecla.Key == ConsoleKey.Backspace && contrasena.Length > 0)
+            {
+                contrasena = contrasena[..^1];
+                Console.Write("\b \b");
+            }
+            else if (!char.IsControl(tecla.KeyChar))
+            {
+                contrasena += tecla.KeyChar;
+                Console.Write("*");
+            }
+        } while (tecla.Key != ConsoleKey.Enter);
+
+        Console.WriteLine();
+        return contrasena;
+    }
+
+    public static decimal LeerDecimal(string etiqueta)
+    {
+        while (true)
+        {
+            Console.Write(etiqueta);
+            var texto = Console.ReadLine();
+            if (decimal.TryParse(texto, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var valor)
+                && valor > 0)
+            {
+                return valor;
+            }
+            EscribirError("Ingresa un monto numérico válido, mayor que cero.");
+        }
+    }
+
+    public static int LeerEntero(string etiqueta, int minimo, int maximo)
+    {
+        while (true)
+        {
+            Console.Write(etiqueta);
+            var texto = Console.ReadLine();
+            if (int.TryParse(texto, out var valor) && valor >= minimo && valor <= maximo)
+            {
+                return valor;
+            }
+            EscribirError($"Ingresa un número entre {minimo} y {maximo}.");
+        }
+    }
+
+    public static bool LeerConfirmacion(string etiqueta)
+    {
+        Console.Write($"{etiqueta} (s/n): ");
+        var respuesta = Console.ReadLine();
+        return respuesta?.Trim().Equals("s", StringComparison.OrdinalIgnoreCase) == true;
+    }
+
+    public static void EscribirTitulo(string texto)
+    {
+        Console.WriteLine();
+        Console.ForegroundColor = ConsoleColor.Cyan;
+        Console.WriteLine($"== {texto} ==");
+        Console.ResetColor();
+    }
+
+    public static void EscribirExito(string texto)
+    {
+        Console.ForegroundColor = ConsoleColor.Green;
+        Console.WriteLine(texto);
+        Console.ResetColor();
+    }
+
+    public static void EscribirError(string texto)
+    {
+        Console.ForegroundColor = ConsoleColor.Red;
+        Console.WriteLine(texto);
+        Console.ResetColor();
+    }
+
+    public static void Pausar()
+    {
+        Console.WriteLine();
+        Console.WriteLine("Presiona ENTER para continuar...");
+        Console.ReadLine();
+    }
+}
