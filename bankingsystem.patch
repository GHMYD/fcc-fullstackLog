+++ b/BankingSystem/src/BankingSystem/Servicios/ServicioContrasenas.cs
@@ -0,0 +1,42 @@
+using System.Security.Cryptography;
+
+namespace BankingSystem.Servicios;
+
+/// <summary>
+/// Genera y verifica hashes de contraseñas usando PBKDF2 (HMAC-SHA256)
+/// con una sal aleatoria distinta por usuario.
+/// </summary>
+public static class ServicioContrasenas
+{
+    private const int TamanoSalBytes = 16;
+    private const int TamanoHashBytes = 32;
+    private const int Iteraciones = 100_000;
+
+    public static (string Hash, string Sal) Generar(string contrasenaPlana)
+    {
+        var sal = RandomNumberGenerator.GetBytes(TamanoSalBytes);
+        var hash = Rfc2898DeriveBytes.Pbkdf2(
+            contrasenaPlana,
+            sal,
+            Iteraciones,
+            HashAlgorithmName.SHA256,
+            TamanoHashBytes);
+
+        return (Convert.ToBase64String(hash), Convert.ToBase64String(sal));
+    }
+
+    public static bool Verificar(string contrasenaPlana, string hashAlmacenado, string salAlmacenada)
+    {
+        var sal = Convert.FromBase64String(salAlmacenada);
+        var hashEsperado = Convert.FromBase64String(hashAlmacenado);
+
+        var hashCalculado = Rfc2898DeriveBytes.Pbkdf2(
+            contrasenaPlana,
+            sal,
+            Iteraciones,
+            HashAlgorithmName.SHA256,
+            hashEsperado.Length);
+
+        return CryptographicOperations.FixedTimeEquals(hashCalculado, hashEsperado);
+    }
+}
