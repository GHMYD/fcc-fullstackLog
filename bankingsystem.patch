+using BankingSystem.Modelos;
+using BankingSystem.Servicios;
+using static BankingSystem.Interfaz.ConsolaAyudante;
+
+namespace BankingSystem.Interfaz;
+
+public class MenuPrincipal
+{
+    private readonly ServicioAutenticacion _autenticacion;
+    private readonly ServicioUsuarios _usuarios;
+    private readonly ServicioTransacciones _transacciones;
+    private readonly ServicioRegistro _registro;
+
+    public MenuPrincipal(
+        ServicioAutenticacion autenticacion,
+        ServicioUsuarios usuarios,
+        ServicioTransacciones transacciones,
+        ServicioRegistro registro)
+    {
+        _autenticacion = autenticacion;
+        _usuarios = usuarios;
+        _transacciones = transacciones;
+        _registro = registro;
+    }
+
+    public void Ejecutar()
+    {
+        EscribirTitulo("Sistema Bancario - C#");
+        Console.WriteLine("Sugerencia: en el primer arranque puedes ingresar con usuario 'admin' y contraseña 'Admin123!'.");
+
+        var continuar = true;
+        while (continuar)
+        {
+            Console.WriteLine();
+            Console.WriteLine("1) Iniciar sesión");
+            Console.WriteLine("2) Salir");
+            var opcion = LeerEntero("Selecciona una opción: ", 1, 2);
+
+            switch (opcion)
+            {
+                case 1:
+                    ManejarInicioSesion();
+                    break;
+                case 2:
+                    continuar = false;
+                    break;
+            }
+        }
+
+        Console.WriteLine("Hasta pronto.");
+    }
+
+    private void ManejarInicioSesion()
+    {
+        var nombreUsuario = LeerTexto("Usuario: ");
+        var contrasena = LeerContrasena("Contraseña: ");
+
+        try
+        {
+            var usuario = _autenticacion.IniciarSesion(nombreUsuario, contrasena);
+            EscribirExito($"Bienvenido, {usuario.NombreCompleto}.");
+
+            if (usuario.EsAdministrador)
+            {
+                MenuAdministrador(usuario);
+            }
+            else
+            {
+                MenuOperacionesBancarias(usuario);
+            }
+        }
+        catch (CredencialesInvalidasException ex)
+        {
+            EscribirError(ex.Message);
+        }
+    }
+
+    // ---------- Menú de administrador ----------
+
+    private void MenuAdministrador(Usuario admin)
+    {
+        var enSesion = true;
+        while (enSesion)
+        {
+            EscribirTitulo($"Panel de administración - {admin.NombreCompleto}");
+            Console.WriteLine("1) Gestión de usuarios (CRUD)");
+            Console.WriteLine("2) Mis operaciones bancarias");
+            Console.WriteLine("3) Ver registro de auditoría (logs)");
+            Console.WriteLine("4) Cerrar sesión");
+            var opcion = LeerEntero("Selecciona una opción: ", 1, 4);
+
+            switch (opcion)
+            {
+                case 1:
+                    GestionUsuarios(admin);
+                    break;
+                case 2:
+                    MenuOperacionesBancarias(admin);
+                    break;
+                case 3:
+                    VerLogs();
+                    break;
+                case 4:
+                    _registro.Registrar("Cierre de sesión.", admin.NombreUsuario);
+                    enSesion = false;
+                    break;
+            }
+        }
+    }
+
+    private void GestionUsuarios(Usuario admin)
+    {
+        var enGestion = true;
+        while (enGestion)
+        {
+            EscribirTitulo("Gestión de usuarios");
+            Console.WriteLine("1) Crear usuario");
+            Console.WriteLine("2) Listar usuarios");
+            Console.WriteLine("3) Actualizar usuario");
+            Console.WriteLine("4) Restablecer contraseña de un usuario");
+            Console.WriteLine("5) Eliminar usuario");
+            Console.WriteLine("6) Volver");
+            var opcion = LeerEntero("Selecciona una opción: ", 1, 6);
+
+            try
+            {
+                switch (opcion)
+                {
+                    case 1:
+                        CrearUsuario(admin);
+                        break;
+                    case 2:
+                        ListarUsuarios();
+                        break;
+                    case 3:
+                        ActualizarUsuario(admin);
+                        break;
+                    case 4:
+                        RestablecerContrasena(admin);
+                        break;
+                    case 5:
+                        EliminarUsuario(admin);
+                        break;
+                    case 6:
+                        enGestion = false;
+                        break;
+                }
+            }
+            catch (Exception ex) when (ex is OperacionInvalidaException or EntidadNoEncontradaException)
+            {
+                EscribirError(ex.Message);
+                Pausar();
+            }
+        }
+    }
+
+    private void CrearUsuario(Usuario admin)
+    {
+        EscribirTitulo("Crear usuario");
+        var nombreUsuario = LeerTexto("Nombre de usuario: ");
+        var nombreCompleto = LeerTexto("Nombre completo: ");
+        var contrasena = LeerContrasena("Contraseña: ");
+        var esAdmin = LeerConfirmacion("¿Es administrador?");
+
+        var usuario = _usuarios.CrearUsuario(nombreUsuario, nombreCompleto, contrasena, esAdmin, admin.NombreUsuario);
+        var cuenta = _usuarios.ObtenerCuentaDeUsuario(usuario);
+        EscribirExito($"Usuario '{usuario.NombreUsuario}' creado con número de cuenta {cuenta.NumeroCuenta}.");
+        Pausar();
+    }
+
+    private void ListarUsuarios()
+    {
+        EscribirTitulo("Usuarios registrados");
+        foreach (var usuario in _usuarios.ObtenerTodos())
+        {
+            var cuenta = _usuarios.ObtenerCuentaDeUsuario(usuario);
+            Console.WriteLine(
+                $"#{usuario.Id} | {usuario.NombreUsuario,-15} | {usuario.NombreCompleto,-25} | " +
+                $"Cuenta: {cuenta.NumeroCuenta} | Saldo: {FormatoMoneda.Formatear(cuenta.Saldo)} | " +
+                $"Admin: {(usuario.EsAdministrador ? "Sí" : "No")} | Activo: {(usuario.Activo ? "Sí" : "No")}");
+        }
+        Pausar();
+    }
+
+    private void ActualizarUsuario(Usuario admin)
+    {
+        EscribirTitulo("Actualizar usuario");
+        var id = LeerEntero("Id del usuario a actualizar: ", 1, int.MaxValue);
+        var usuario = _usuarios.ObtenerPorId(id);
+
+        Console.WriteLine($"Nombre completo actual: {usuario.NombreCompleto}");
+        var nombreCompleto = LeerTexto("Nuevo nombre completo (repite si no cambia): ");
+        var esAdmin = LeerConfirmacion("¿Es administrador?");
+        var activo = LeerConfirmacion("¿Cuenta activa?");
+
+        _usuarios.ActualizarDatos(usuario, nombreCompleto, esAdmin, activo, admin.NombreUsuario);
+        EscribirExito("Usuario actualizado correctamente.");
+        Pausar();
+    }
+
+    private void RestablecerContrasena(Usuario admin)
+    {
+        EscribirTitulo("Restablecer contraseña");
+        var id = LeerEntero("Id del usuario: ", 1, int.MaxValue);
+        var usuario = _usuarios.ObtenerPorId(id);
+        var nuevaContrasena = LeerContrasena("Nueva contraseña: ");
+
+        _usuarios.RestablecerContrasena(usuario, nuevaContrasena, admin.NombreUsuario);
+        EscribirExito("Contraseña restablecida correctamente.");
+        Pausar();
+    }
+
+    private void EliminarUsuario(Usuario admin)
+    {
+        EscribirTitulo("Eliminar usuario");
+        var id = LeerEntero("Id del usuario a eliminar: ", 1, int.MaxValue);
+        var usuario = _usuarios.ObtenerPorId(id);
+
+        if (!LeerConfirmacion($"¿Confirmas eliminar a '{usuario.NombreUsuario}'?"))
+        {
+            Console.WriteLine("Operación cancelada.");
+            Pausar();
+            return;
+        }
+
+        _usuarios.EliminarUsuario(usuario, admin);
+        EscribirExito("Usuario eliminado correctamente.");
+        Pausar();
+    }
+
+    private void VerLogs()
+    {
+        EscribirTitulo("Últimas líneas del registro de auditoría de hoy");
+        var lineas = _registro.LeerUltimasLineas(30);
+        if (lineas.Count == 0)
+        {
+            Console.WriteLine("Aún no hay registros para el día de hoy.");
+        }
+        else
+        {
+            foreach (var linea in lineas)
+            {
+                Console.WriteLine(linea);
+            }
+        }
+        Pausar();
+    }
+
+    // ---------- Menú de operaciones bancarias (usuario o admin) ----------
+
+    private void MenuOperacionesBancarias(Usuario usuario)
+    {
+        var cuenta = _usuarios.ObtenerCuentaDeUsuario(usuario);
+        var enSesion = true;
+
+        while (enSesion)
+        {
+            EscribirTitulo($"Operaciones bancarias - {usuario.NombreCompleto} ({cuenta.NumeroCuenta})");
+            Console.WriteLine("1) Consultar saldo");
+            Console.WriteLine("2) Registrar ingreso (depósito)");
+            Console.WriteLine("3) Registrar salida (retiro)");
+            Console.WriteLine("4) Transferir a otra cuenta");
+            Console.WriteLine("5) Ver historial de movimientos");
+            Console.WriteLine("6) Cambiar mi contraseña");
+            Console.WriteLine("7) Volver");
+            var opcion = LeerEntero("Selecciona una opción: ", 1, 7);
+
+            try
+            {
+                switch (opcion)
+                {
+                    case 1:
+                        ConsultarSaldo(cuenta);
+                        break;
+                    case 2:
+                        RegistrarIngreso(cuenta, usuario);
+                        break;
+                    case 3:
+                        RegistrarSalida(cuenta, usuario);
+                        break;
+                    case 4:
+                        Transferir(cuenta, usuario);
+                        break;
+                    case 5:
+                        VerHistorial(cuenta);
+                        break;
+                    case 6:
+                        CambiarContrasena(usuario);
+                        break;
+                    case 7:
+                        enSesion = false;
+                        break;
+                }
+            }
+            catch (Exception ex) when (ex is SaldoInsuficienteException or OperacionInvalidaException or CredencialesInvalidasException)
+            {
+                EscribirError(ex.Message);
+                Pausar();
+            }
+        }
+    }
+
+    private void ConsultarSaldo(Cuenta cuenta)
+    {
+        EscribirTitulo("Saldo actual");
+        Console.WriteLine($"Cuenta {cuenta.NumeroCuenta}: {FormatoMoneda.Formatear(_transacciones.ConsultarSaldo(cuenta))}");
+        Pausar();
+    }
+
+    private void RegistrarIngreso(Cuenta cuenta, Usuario usuario)
+    {
+        EscribirTitulo("Registrar ingreso");
+        var monto = LeerDecimal("Monto a ingresar: ");
+        var descripcion = LeerTexto("Descripción (por ejemplo: sueldo, depósito): ");
+
+        _transacciones.RegistrarIngreso(cuenta, monto, descripcion, usuario.NombreUsuario);
+        EscribirExito($"Ingreso registrado. Nuevo saldo: {FormatoMoneda.Formatear(cuenta.Saldo)}");
+        Pausar();
+    }
+
+    private void RegistrarSalida(Cuenta cuenta, Usuario usuario)
+    {
+        EscribirTitulo("Registrar salida");
+        var monto = LeerDecimal("Monto a retirar: ");
+        var descripcion = LeerTexto("Descripción (por ejemplo: pago, compra): ");
+
+        _transacciones.RegistrarSalida(cuenta, monto, descripcion, usuario.NombreUsuario);
+        EscribirExito($"Salida registrada. Nuevo saldo: {FormatoMoneda.Formatear(cuenta.Saldo)}");
+        Pausar();
+    }
+
+    private void Transferir(Cuenta cuentaOrigen, Usuario usuario)
+    {
+        EscribirTitulo("Transferencia");
+        var numeroDestino = LeerTexto("Número de cuenta destino (ej: CTA-000002): ");
+        var cuentaDestino = _transacciones.BuscarCuentaPorNumero(numeroDestino);
+
+        if (cuentaDestino is null)
+        {
+            EscribirError("No existe ninguna cuenta con ese número.");
+            Pausar();
+            return;
+        }
+
+        var monto = LeerDecimal("Monto a transferir: ");
+        var descripcion = LeerTexto("Descripción: ");
+
+        _transacciones.Transferir(cuentaOrigen, cuentaDestino, monto, descripcion, usuario.NombreUsuario);
+        EscribirExito($"Transferencia realizada. Nuevo saldo: {FormatoMoneda.Formatear(cuentaOrigen.Saldo)}");
+        Pausar();
+    }
+
+    private void VerHistorial(Cuenta cuenta)
+    {
+        EscribirTitulo("Historial de movimientos");
+        var movimientos = _transacciones.ObtenerHistorial(cuenta);
+
+        if (movimientos.Count == 0)
+        {
+            Console.WriteLine("Aún no hay movimientos registrados.");
+        }
+        else
+        {
+            foreach (var movimiento in movimientos)
+            {
+                Console.WriteLine(
+                    $"[{movimiento.FechaHora:yyyy-MM-dd HH:mm:ss}] {movimiento.Tipo,-22} " +
+                    $"Monto: {FormatoMoneda.Formatear(movimiento.Monto),-12} Saldo resultante: {FormatoMoneda.Formatear(movimiento.SaldoResultante)} " +
+                    $"- {movimiento.Descripcion}");
+            }
+        }
+        Pausar();
+    }
+
+    private void CambiarContrasena(Usuario usuario)
+    {
+        EscribirTitulo("Cambiar contraseña");
+        var actual = LeerContrasena("Contraseña actual: ");
+        var nueva = LeerContrasena("Contraseña nueva: ");
+
+        _autenticacion.CambiarContrasena(usuario, actual, nueva);
+        EscribirExito("Contraseña actualizada correctamente.");
+        Pausar();
+    }
+}
