+using BankingSystem.Datos;
+using BankingSystem.Modelos;
+
+namespace BankingSystem.Servicios;
+
+/// <summary>
+/// Operaciones bancarias: consulta de saldo, ingresos (depósitos),
+/// salidas (retiros), transferencias entre cuentas e historial de movimientos.
+/// </summary>
+public class ServicioTransacciones
+{
+    private readonly AlmacenJson<Cuenta> _cuentas;
+    private readonly AlmacenJson<Transaccion> _transacciones;
+    private readonly ServicioRegistro _registro;
+    private readonly object _bloqueoOperaciones = new();
+
+    public ServicioTransacciones(AlmacenJson<Cuenta> cuentas, AlmacenJson<Transaccion> transacciones, ServicioRegistro registro)
+    {
+        _cuentas = cuentas;
+        _transacciones = transacciones;
+        _registro = registro;
+    }
+
+    public decimal ConsultarSaldo(Cuenta cuenta) => cuenta.Saldo;
+
+    public Cuenta? BuscarCuentaPorNumero(string numeroCuenta) =>
+        _cuentas.BuscarPor(c => string.Equals(c.NumeroCuenta, numeroCuenta, StringComparison.OrdinalIgnoreCase));
+
+    public Transaccion RegistrarIngreso(Cuenta cuenta, decimal monto, string descripcion, string actor)
+    {
+        ValidarMonto(monto);
+
+        lock (_bloqueoOperaciones)
+        {
+            cuenta.Saldo += monto;
+            _cuentas.Actualizar();
+
+            var transaccion = CrearYGuardarTransaccion(cuenta.Id, null, TipoTransaccion.Ingreso, monto, cuenta.Saldo, descripcion);
+            _registro.Registrar($"Ingreso de {FormatoMoneda.Formatear(monto)} en cuenta {cuenta.NumeroCuenta}. Saldo nuevo: {FormatoMoneda.Formatear(cuenta.Saldo)}.", actor);
+            return transaccion;
+        }
+    }
+
+    public Transaccion RegistrarSalida(Cuenta cuenta, decimal monto, string descripcion, string actor)
+    {
+        ValidarMonto(monto);
+
+        lock (_bloqueoOperaciones)
+        {
+            if (cuenta.Saldo < monto)
+            {
+                throw new SaldoInsuficienteException(
+                    $"Saldo insuficiente. Saldo actual: {FormatoMoneda.Formatear(cuenta.Saldo)}, monto solicitado: {FormatoMoneda.Formatear(monto)}.");
+            }
+
+            cuenta.Saldo -= monto;
+            _cuentas.Actualizar();
+
+            var transaccion = CrearYGuardarTransaccion(cuenta.Id, null, TipoTransaccion.Salida, monto, cuenta.Saldo, descripcion);
+            _registro.Registrar($"Salida de {FormatoMoneda.Formatear(monto)} en cuenta {cuenta.NumeroCuenta}. Saldo nuevo: {FormatoMoneda.Formatear(cuenta.Saldo)}.", actor);
+            return transaccion;
+        }
+    }
+
+    public void Transferir(Cuenta cuentaOrigen, Cuenta cuentaDestino, decimal monto, string descripcion, string actor)
+    {
+        ValidarMonto(monto);
+
+        if (cuentaOrigen.Id == cuentaDestino.Id)
+        {
+            throw new OperacionInvalidaException("No puedes transferir a tu propia cuenta.");
+        }
+
+        lock (_bloqueoOperaciones)
+        {
+            if (cuentaOrigen.Saldo < monto)
+            {
+                throw new SaldoInsuficienteException(
+                    $"Saldo insuficiente para transferir. Saldo actual: {FormatoMoneda.Formatear(cuentaOrigen.Saldo)}, monto solicitado: {FormatoMoneda.Formatear(monto)}.");
+            }
+
+            cuentaOrigen.Saldo -= monto;
+            cuentaDestino.Saldo += monto;
+            _cuentas.Actualizar();
+
+            CrearYGuardarTransaccion(cuentaOrigen.Id, cuentaDestino.Id, TipoTransaccion.TransferenciaEnviada, monto, cuentaOrigen.Saldo, descripcion);
+            CrearYGuardarTransaccion(cuentaDestino.Id, cuentaOrigen.Id, TipoTransaccion.TransferenciaRecibida, monto, cuentaDestino.Saldo, descripcion);
+
+            _registro.Registrar(
+                $"Transferencia de {FormatoMoneda.Formatear(monto)} desde {cuentaOrigen.NumeroCuenta} hacia {cuentaDestino.NumeroCuenta}.",
+                actor);
+        }
+    }
+
+    public IReadOnlyList<Transaccion> ObtenerHistorial(Cuenta cuenta) =>
+        _transacciones.BuscarTodosPor(t => t.CuentaId == cuenta.Id)
+            .OrderByDescending(t => t.FechaHora)
+            .ToList();
+
+    private Transaccion CrearYGuardarTransaccion(
+        int cuentaId, int? cuentaContrapartId, TipoTransaccion tipo, decimal monto, decimal saldoResultante, string descripcion)
+    {
+        var siguienteId = _transacciones.ObtenerTodos().Select(t => t.Id).DefaultIfEmpty(0).Max() + 1;
+        var transaccion = new Transaccion
+        {
+            Id = siguienteId,
+            CuentaId = cuentaId,
+            CuentaContrapartId = cuentaContrapartId,
+            Tipo = tipo,
+            Monto = monto,
+            SaldoResultante = saldoResultante,
+            Descripcion = descripcion,
+            FechaHora = DateTime.Now
+        };
+        _transacciones.Agregar(transaccion);
+        return transaccion;
+    }
+
+    private static void ValidarMonto(decimal monto)
+    {
+        if (monto <= 0)
+        {
+            throw new OperacionInvalidaException("El monto debe ser mayor que cero.");
+        }
+    }
+}
