+using BankingSystem.Servicios;
+
+namespace BankingSystem.Tests;
+
+public class ServicioAutenticacionTests : PruebaConAlmacenamientoTemporal
+{
+    [Fact]
+    public void Constructor_CreaAdministradorPorDefecto_CuandoNoHayUsuarios()
+    {
+        var autenticacion = new ServicioAutenticacion(Usuarios, Cuentas, Registro);
+
+        var admin = autenticacion.IniciarSesion("admin", "Admin123!");
+
+        Assert.True(admin.EsAdministrador);
+        Assert.Single(Usuarios.ObtenerTodos());
+        Assert.Single(Cuentas.ObtenerTodos());
+    }
+
+    [Fact]
+    public void IniciarSesion_LanzaExcepcion_ConCredencialesIncorrectas()
+    {
+        var autenticacion = new ServicioAutenticacion(Usuarios, Cuentas, Registro);
+
+        Assert.Throws<CredencialesInvalidasException>(() => autenticacion.IniciarSesion("admin", "clave-incorrecta"));
+    }
+
+    [Fact]
+    public void IniciarSesion_LanzaExcepcion_ConUsuarioInexistente()
+    {
+        var autenticacion = new ServicioAutenticacion(Usuarios, Cuentas, Registro);
+
+        Assert.Throws<CredencialesInvalidasException>(() => autenticacion.IniciarSesion("no-existe", "cualquiera"));
+    }
+
+    [Fact]
+    public void CambiarContrasena_PermiteIniciarSesionConLaNueva()
+    {
+        var autenticacion = new ServicioAutenticacion(Usuarios, Cuentas, Registro);
+        var admin = autenticacion.IniciarSesion("admin", "Admin123!");
+
+        autenticacion.CambiarContrasena(admin, "Admin123!", "NuevaClave456!");
+
+        Assert.Throws<CredencialesInvalidasException>(() => autenticacion.IniciarSesion("admin", "Admin123!"));
+        var reconectado = autenticacion.IniciarSesion("admin", "NuevaClave456!");
+        Assert.Equal(admin.Id, reconectado.Id);
+    }
+
+    [Fact]
+    public void CambiarContrasena_LanzaExcepcion_SiLaActualEsIncorrecta()
+    {
+        var autenticacion = new ServicioAutenticacion(Usuarios, Cuentas, Registro);
+        var admin = autenticacion.IniciarSesion("admin", "Admin123!");
+
+        Assert.Throws<CredencialesInvalidasException>(
+            () => autenticacion.CambiarContrasena(admin, "clave-mala", "NuevaClave456!"));
+    }
+}
