@@ -0,0 +1,96 @@
+using BankingSystem.Datos;
+using BankingSystem.Modelos;
+
+namespace BankingSystem.Servicios;
+
+/// <summary>
+/// Maneja el inicio de sesión por usuario y contraseña, y garantiza que
+/// exista al menos un administrador cuando el sistema arranca por primera vez.
+/// </summary>
+public class ServicioAutenticacion
+{
+    private readonly AlmacenJson<Usuario> _usuarios;
+    private readonly AlmacenJson<Cuenta> _cuentas;
+    private readonly ServicioRegistro _registro;
+
+    public ServicioAutenticacion(AlmacenJson<Usuario> usuarios, AlmacenJson<Cuenta> cuentas, ServicioRegistro registro)
+    {
+        _usuarios = usuarios;
+        _cuentas = cuentas;
+        _registro = registro;
+        AsegurarAdministradorPorDefecto();
+    }
+
+    private void AsegurarAdministradorPorDefecto()
+    {
+        if (_usuarios.ObtenerTodos().Any())
+        {
+            return;
+        }
+
+        const string usuarioAdmin = "admin";
+        const string contrasenaAdmin = "Admin123!";
+
+        var (hash, sal) = ServicioContrasenas.Generar(contrasenaAdmin);
+        var siguienteIdUsuario = 1;
+        var siguienteIdCuenta = 1;
+
+        var cuenta = new Cuenta
+        {
+            Id = siguienteIdCuenta,
+            UsuarioId = siguienteIdUsuario,
+            NumeroCuenta = GenerarNumeroCuenta(siguienteIdCuenta),
+            Saldo = 0m
+        };
+        _cuentas.Agregar(cuenta);
+
+        var admin = new Usuario
+        {
+            Id = siguienteIdUsuario,
+            NombreUsuario = usuarioAdmin,
+            NombreCompleto = "Administrador",
+            HashContrasena = hash,
+            Sal = sal,
+            EsAdministrador = true,
+            Activo = true,
+            CuentaId = cuenta.Id
+        };
+        _usuarios.Agregar(admin);
+
+        _registro.Registrar(
+            $"Usuario administrador por defecto creado (usuario: {usuarioAdmin}, contraseña inicial: {contrasenaAdmin}).",
+            "sistema");
+    }
+
+    public static string GenerarNumeroCuenta(int idCuenta) => $"CTA-{idCuenta:D6}";
+
+    public Usuario IniciarSesion(string nombreUsuario, string contrasena)
+    {
+        var usuario = _usuarios.BuscarPor(u =>
+            string.Equals(u.NombreUsuario, nombreUsuario, StringComparison.OrdinalIgnoreCase));
+
+        if (usuario is null || !usuario.Activo || !ServicioContrasenas.Verificar(contrasena, usuario.HashContrasena, usuario.Sal))
+        {
+            _registro.Registrar($"Intento de inicio de sesión fallido para '{nombreUsuario}'.", "sistema");
+            throw new CredencialesInvalidasException("Usuario o contraseña incorrectos, o la cuenta está inactiva.");
+        }
+
+        _registro.Registrar("Inicio de sesión exitoso.", usuario.NombreUsuario);
+        return usuario;
+    }
+
+    public void CambiarContrasena(Usuario usuario, string contrasenaActual, string contrasenaNueva)
+    {
+        if (!ServicioContrasenas.Verificar(contrasenaActual, usuario.HashContrasena, usuario.Sal))
+        {
+            throw new CredencialesInvalidasException("La contraseña actual no es correcta.");
+        }
+
+        var (hash, sal) = ServicioContrasenas.Generar(contrasenaNueva);
+        usuario.HashContrasena = hash;
+        usuario.Sal = sal;
+        _usuarios.Actualizar();
+
+        _registro.Registrar("Contraseña actualizada.", usuario.NombreUsuario);
+    }
+}
