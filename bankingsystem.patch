+using BankingSystem.Servicios;
+
+namespace BankingSystem.Tests;
+
+public class ServicioUsuariosTests : PruebaConAlmacenamientoTemporal
+{
+    private readonly ServicioUsuarios _servicio;
+
+    public ServicioUsuariosTests()
+    {
+        _servicio = new ServicioUsuarios(Usuarios, Cuentas, Registro);
+    }
+
+    [Fact]
+    public void CrearUsuario_AgregaElUsuarioConSuCuentaAsociada()
+    {
+        var usuario = _servicio.CrearUsuario("juan", "Juan Perez", "clave123", esAdministrador: false, actor: "admin");
+
+        Assert.Equal("juan", usuario.NombreUsuario);
+        var cuenta = _servicio.ObtenerCuentaDeUsuario(usuario);
+        Assert.Equal(0m, cuenta.Saldo);
+        Assert.Single(_servicio.ObtenerTodos());
+    }
+
+    [Fact]
+    public void CrearUsuario_LanzaExcepcion_SiElNombreYaExiste()
+    {
+        _servicio.CrearUsuario("juan", "Juan Perez", "clave123", false, "admin");
+
+        Assert.Throws<OperacionInvalidaException>(
+            () => _servicio.CrearUsuario("JUAN", "Otro Nombre", "otraClave", false, "admin"));
+    }
+
+    [Fact]
+    public void CrearUsuario_LanzaExcepcion_SiFaltanDatosObligatorios()
+    {
+        Assert.Throws<OperacionInvalidaException>(() => _servicio.CrearUsuario("", "Nombre", "clave123", false, "admin"));
+        Assert.Throws<OperacionInvalidaException>(() => _servicio.CrearUsuario("usuario", "Nombre", "", false, "admin"));
+    }
+
+    [Fact]
+    public void ActualizarDatos_ModificaNombreAdminYEstadoActivo()
+    {
+        var usuario = _servicio.CrearUsuario("juan", "Juan Perez", "clave123", false, "admin");
+
+        _servicio.ActualizarDatos(usuario, "Juan Actualizado", esAdministrador: true, activo: false, actor: "admin");
+
+        Assert.Equal("Juan Actualizado", usuario.NombreCompleto);
+        Assert.True(usuario.EsAdministrador);
+        Assert.False(usuario.Activo);
+    }
+
+    [Fact]
+    public void RestablecerContrasena_PermiteVerificarLaNueva()
+    {
+        var usuario = _servicio.CrearUsuario("juan", "Juan Perez", "clave123", false, "admin");
+
+        _servicio.RestablecerContrasena(usuario, "nuevaClave456", "admin");
+
+        Assert.True(ServicioContrasenas.Verificar("nuevaClave456", usuario.HashContrasena, usuario.Sal));
+    }
+
+    [Fact]
+    public void EliminarUsuario_QuitaElUsuarioYSuCuenta()
+    {
+        var admin = _servicio.CrearUsuario("admin", "Administrador", "AdminClave1", true, "sistema");
+        var usuario = _servicio.CrearUsuario("juan", "Juan Perez", "clave123", false, "admin");
+
+        _servicio.EliminarUsuario(usuario, admin);
+
+        Assert.Equal(1, _servicio.ObtenerTodos().Count);
+    }
+
+    [Fact]
+    public void EliminarUsuario_LanzaExcepcion_SiTieneSaldoPendiente()
+    {
+        var admin = _servicio.CrearUsuario("admin", "Administrador", "AdminClave1", true, "sistema");
+        var usuario = _servicio.CrearUsuario("juan", "Juan Perez", "clave123", false, "admin");
+        var cuenta = _servicio.ObtenerCuentaDeUsuario(usuario);
+        cuenta.Saldo = 100m;
+
+        Assert.Throws<OperacionInvalidaException>(() => _servicio.EliminarUsuario(usuario, admin));
+    }
+
+    [Fact]
+    public void EliminarUsuario_LanzaExcepcion_SiEsElUltimoAdministrador()
+    {
+        var admin = _servicio.CrearUsuario("admin", "Administrador", "AdminClave1", true, "sistema");
+        var juan = _servicio.CrearUsuario("juan", "Juan Perez", "clave123", false, "admin");
+
+        Assert.Throws<OperacionInvalidaException>(() => _servicio.EliminarUsuario(admin, juan));
+    }
+
+    [Fact]
+    public void EliminarUsuario_LanzaExcepcion_SiIntentaEliminarseASiMismo()
+    {
+        var admin = _servicio.CrearUsuario("admin", "Administrador", "AdminClave1", true, "sistema");
+
+        Assert.Throws<OperacionInvalidaException>(() => _servicio.EliminarUsuario(admin, admin));
+    }
+}
