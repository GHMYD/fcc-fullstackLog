new file mode 100644
index 0000000..53f65eb
--- /dev/null
+++ b/BankingSystem/src/BankingSystem/Servicios/ServicioUsuarios.cs
@@ -0,0 +1,139 @@
+using BankingSystem.Datos;
+using BankingSystem.Modelos;
+
+namespace BankingSystem.Servicios;
+
+/// <summary>
+/// CRUD de usuarios y sus cuentas asociadas. Pensado para ser usado
+/// desde el menú de administración.
+/// </summary>
+public class ServicioUsuarios
+{
+    private readonly AlmacenJson<Usuario> _usuarios;
+    private readonly AlmacenJson<Cuenta> _cuentas;
+    private readonly ServicioRegistro _registro;
+
+    public ServicioUsuarios(AlmacenJson<Usuario> usuarios, AlmacenJson<Cuenta> cuentas, ServicioRegistro registro)
+    {
+        _usuarios = usuarios;
+        _cuentas = cuentas;
+        _registro = registro;
+    }
+
+    public IReadOnlyList<Usuario> ObtenerTodos() =>
+        _usuarios.ObtenerTodos().OrderBy(u => u.Id).ToList();
+
+    public Usuario ObtenerPorId(int id) =>
+        _usuarios.BuscarPor(u => u.Id == id)
+        ?? throw new EntidadNoEncontradaException($"No existe un usuario con id {id}.");
+
+    public Cuenta ObtenerCuentaDeUsuario(Usuario usuario) =>
+        _cuentas.BuscarPor(c => c.Id == usuario.CuentaId)
+        ?? throw new EntidadNoEncontradaException($"El usuario '{usuario.NombreUsuario}' no tiene una cuenta asociada.");
+
+    // Create
+    public Usuario CrearUsuario(string nombreUsuario, string nombreCompleto, string contrasena, bool esAdministrador, string actor)
+    {
+        nombreUsuario = nombreUsuario.Trim();
+        if (string.IsNullOrWhiteSpace(nombreUsuario) || string.IsNullOrWhiteSpace(contrasena))
+        {
+            throw new OperacionInvalidaException("El nombre de usuario y la contraseña son obligatorios.");
+        }
+
+        if (_usuarios.BuscarPor(u => string.Equals(u.NombreUsuario, nombreUsuario, StringComparison.OrdinalIgnoreCase)) is not null)
+        {
+            throw new OperacionInvalidaException($"El usuario '{nombreUsuario}' ya existe.");
+        }
+
+        var siguienteIdUsuario = SiguienteId(_usuarios.ObtenerTodos().Select(u => u.Id));
+        var siguienteIdCuenta = SiguienteId(_cuentas.ObtenerTodos().Select(c => c.Id));
+
+        var cuenta = new Cuenta
+        {
+            Id = siguienteIdCuenta,
+            UsuarioId = siguienteIdUsuario,
+            NumeroCuenta = ServicioAutenticacion.GenerarNumeroCuenta(siguienteIdCuenta),
+            Saldo = 0m
+        };
+        _cuentas.Agregar(cuenta);
+
+        var (hash, sal) = ServicioContrasenas.Generar(contrasena);
+        var usuario = new Usuario
+        {
+            Id = siguienteIdUsuario,
+            NombreUsuario = nombreUsuario,
+            NombreCompleto = string.IsNullOrWhiteSpace(nombreCompleto) ? nombreUsuario : nombreCompleto,
+            HashContrasena = hash,
+            Sal = sal,
+            EsAdministrador = esAdministrador,
+            Activo = true,
+            CuentaId = cuenta.Id
+        };
+        _usuarios.Agregar(usuario);
+
+        _registro.Registrar($"Usuario '{nombreUsuario}' creado con cuenta {cuenta.NumeroCuenta} (admin: {esAdministrador}).", actor);
+        return usuario;
+    }
+
+    // Update
+    public void ActualizarDatos(Usuario usuario, string nombreCompleto, bool esAdministrador, bool activo, string actor)
+    {
+        usuario.NombreCompleto = string.IsNullOrWhiteSpace(nombreCompleto) ? usuario.NombreCompleto : nombreCompleto;
+        usuario.EsAdministrador = esAdministrador;
+        usuario.Activo = activo;
+        _usuarios.Actualizar();
+
+        _registro.Registrar($"Usuario '{usuario.NombreUsuario}' actualizado (admin: {esAdministrador}, activo: {activo}).", actor);
+    }
+
+    public void RestablecerContrasena(Usuario usuario, string contrasenaNueva, string actor)
+    {
+        if (string.IsNullOrWhiteSpace(contrasenaNueva))
+        {
+            throw new OperacionInvalidaException("La nueva contraseña no puede estar vacía.");
+        }
+
+        var (hash, sal) = ServicioContrasenas.Generar(contrasenaNueva);
+        usuario.HashContrasena = hash;
+        usuario.Sal = sal;
+        _usuarios.Actualizar();
+
+        _registro.Registrar($"Contraseña de '{usuario.NombreUsuario}' restablecida por un administrador.", actor);
+    }
+
+    // Delete
+    public void EliminarUsuario(Usuario usuario, Usuario solicitante)
+    {
+        if (usuario.Id == solicitante.Id)
+        {
+            throw new OperacionInvalidaException("No puedes eliminar tu propio usuario mientras tienes la sesión abierta.");
+        }
+
+        var cuenta = _cuentas.BuscarPor(c => c.Id == usuario.CuentaId);
+        if (cuenta is not null && cuenta.Saldo != 0m)
+        {
+            throw new OperacionInvalidaException(
+                $"No se puede eliminar: la cuenta {cuenta.NumeroCuenta} tiene saldo pendiente ({FormatoMoneda.Formatear(cuenta.Saldo)}).");
+        }
+
+        var otrosAdmins = _usuarios.BuscarTodosPor(u => u.EsAdministrador && u.Id != usuario.Id).Any();
+        if (usuario.EsAdministrador && !otrosAdmins)
+        {
+            throw new OperacionInvalidaException("No se puede eliminar al último administrador del sistema.");
+        }
+
+        if (cuenta is not null)
+        {
+            _cuentas.Eliminar(cuenta);
+        }
+        _usuarios.Eliminar(usuario);
+
+        _registro.Registrar($"Usuario '{usuario.NombreUsuario}' eliminado.", solicitante.NombreUsuario);
+    }
+
+    private static int SiguienteId(IEnumerable<int> idsExistentes)
+    {
+        var lista = idsExistentes.ToList();
+        return lista.Count == 0 ? 1 : lista.Max() + 1;
+    }
+}
