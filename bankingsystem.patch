@@ -0,0 +1,46 @@
+namespace BankingSystem.Servicios;
+
+/// <summary>
+/// Registra un log de auditoría de todas las operaciones relevantes del sistema.
+/// Cada línea queda marcada con fecha, hora y minuto exactos, y se agrupa
+/// en un archivo por día dentro de la carpeta "logs".
+/// </summary>
+public class ServicioRegistro
+{
+    private readonly string _carpetaLogs;
+    private readonly object _bloqueo = new();
+
+    public ServicioRegistro(string carpetaLogs)
+    {
+        _carpetaLogs = carpetaLogs;
+        Directory.CreateDirectory(_carpetaLogs);
+    }
+
+    private string ArchivoDelDia => Path.Combine(_carpetaLogs, $"{DateTime.Now:yyyy-MM-dd}.log");
+
+    public void Registrar(string mensaje, string? usuario = null)
+    {
+        var marcaTiempo = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
+        var quien = string.IsNullOrWhiteSpace(usuario) ? "sistema" : usuario;
+        var linea = $"[{marcaTiempo}] ({quien}) {mensaje}";
+
+        lock (_bloqueo)
+        {
+            File.AppendAllText(ArchivoDelDia, linea + Environment.NewLine);
+        }
+    }
+
+    public IReadOnlyList<string> LeerUltimasLineas(int cantidad)
+    {
+        if (!File.Exists(ArchivoDelDia))
+        {
+            return Array.Empty<string>();
+        }
+
+        lock (_bloqueo)
+        {
+            var todas = File.ReadAllLines(ArchivoDelDia);
+            return todas.Skip(Math.Max(0, todas.Length - cantidad)).ToArray();
+        }
+    }
+}
