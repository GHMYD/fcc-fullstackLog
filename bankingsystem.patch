@@ -0,0 +1,39 @@
+using BankingSystem.Datos;
+using BankingSystem.Modelos;
+using BankingSystem.Servicios;
+
+namespace BankingSystem.Tests;
+
+/// <summary>
+/// Base para pruebas que necesitan almacenes JSON y un servicio de registro
+/// reales, pero aislados en una carpeta temporal que se borra al finalizar.
+/// </summary>
+public abstract class PruebaConAlmacenamientoTemporal : IDisposable
+{
+    private readonly string _carpetaTemporal;
+
+    protected AlmacenJson<Usuario> Usuarios { get; }
+    protected AlmacenJson<Cuenta> Cuentas { get; }
+    protected AlmacenJson<Transaccion> Transacciones { get; }
+    protected ServicioRegistro Registro { get; }
+
+    protected PruebaConAlmacenamientoTemporal()
+    {
+        _carpetaTemporal = Path.Combine(Path.GetTempPath(), "BankingSystemTests_" + Guid.NewGuid());
+        Directory.CreateDirectory(_carpetaTemporal);
+
+        Usuarios = new AlmacenJson<Usuario>(Path.Combine(_carpetaTemporal, "usuarios.json"));
+        Cuentas = new AlmacenJson<Cuenta>(Path.Combine(_carpetaTemporal, "cuentas.json"));
+        Transacciones = new AlmacenJson<Transaccion>(Path.Combine(_carpetaTemporal, "transacciones.json"));
+        Registro = new ServicioRegistro(Path.Combine(_carpetaTemporal, "logs"));
+    }
+
+    public void Dispose()
+    {
+        if (Directory.Exists(_carpetaTemporal))
+        {
+            Directory.Delete(_carpetaTemporal, recursive: true);
+        }
+        GC.SuppressFinalize(this);
+    }
+}
