+using BankingSystem.Modelos;
+using BankingSystem.Servicios;
+
+namespace BankingSystem.Tests;
+
+public class ServicioTransaccionesTests : PruebaConAlmacenamientoTemporal
+{
+    private readonly ServicioTransacciones _servicio;
+    private readonly Cuenta _cuentaA;
+    private readonly Cuenta _cuentaB;
+
+    public ServicioTransaccionesTests()
+    {
+        _servicio = new ServicioTransacciones(Cuentas, Transacciones, Registro);
+
+        _cuentaA = new Cuenta { Id = 1, UsuarioId = 1, NumeroCuenta = "CTA-000001", Saldo = 0m };
+        _cuentaB = new Cuenta { Id = 2, UsuarioId = 2, NumeroCuenta = "CTA-000002", Saldo = 0m };
+        Cuentas.Agregar(_cuentaA);
+        Cuentas.Agregar(_cuentaB);
+    }
+
+    [Fact]
+    public void RegistrarIngreso_AumentaElSaldoYQuedaEnElHistorial()
+    {
+        _servicio.RegistrarIngreso(_cuentaA, 500m, "sueldo", "prueba");
+
+        Assert.Equal(500m, _cuentaA.Saldo);
+        var historial = _servicio.ObtenerHistorial(_cuentaA);
+        Assert.Single(historial);
+        Assert.Equal(TipoTransaccion.Ingreso, historial[0].Tipo);
+    }
+
+    [Fact]
+    public void RegistrarIngreso_LanzaExcepcion_ConMontoNegativoOCero()
+    {
+        Assert.Throws<OperacionInvalidaException>(() => _servicio.RegistrarIngreso(_cuentaA, 0m, "x", "prueba"));
+        Assert.Throws<OperacionInvalidaException>(() => _servicio.RegistrarIngreso(_cuentaA, -10m, "x", "prueba"));
+    }
+
+    [Fact]
+    public void RegistrarSalida_DisminuyeElSaldo_CuandoHayFondos()
+    {
+        _servicio.RegistrarIngreso(_cuentaA, 500m, "sueldo", "prueba");
+
+        _servicio.RegistrarSalida(_cuentaA, 200m, "compra", "prueba");
+
+        Assert.Equal(300m, _cuentaA.Saldo);
+    }
+
+    [Fact]
+    public void RegistrarSalida_LanzaExcepcion_SiElSaldoEsInsuficiente()
+    {
+        Assert.Throws<SaldoInsuficienteException>(() => _servicio.RegistrarSalida(_cuentaA, 100m, "compra", "prueba"));
+        Assert.Equal(0m, _cuentaA.Saldo);
+    }
+
+    [Fact]
+    public void Transferir_MueveElDineroDeUnaCuentaAOtra()
+    {
+        _servicio.RegistrarIngreso(_cuentaA, 500m, "sueldo", "prueba");
+
+        _servicio.Transferir(_cuentaA, _cuentaB, 150m, "pago", "prueba");
+
+        Assert.Equal(350m, _cuentaA.Saldo);
+        Assert.Equal(150m, _cuentaB.Saldo);
+        Assert.Single(_servicio.ObtenerHistorial(_cuentaA).Where(t => t.Tipo == TipoTransaccion.TransferenciaEnviada));
+        Assert.Single(_servicio.ObtenerHistorial(_cuentaB).Where(t => t.Tipo == TipoTransaccion.TransferenciaRecibida));
+    }
+
+    [Fact]
+    public void Transferir_LanzaExcepcion_SiElSaldoEsInsuficiente()
+    {
+        Assert.Throws<SaldoInsuficienteException>(() => _servicio.Transferir(_cuentaA, _cuentaB, 50m, "pago", "prueba"));
+    }
+
+    [Fact]
+    public void Transferir_LanzaExcepcion_HaciaLaMismaCuenta()
+    {
+        _servicio.RegistrarIngreso(_cuentaA, 500m, "sueldo", "prueba");
+
+        Assert.Throws<OperacionInvalidaException>(() => _servicio.Transferir(_cuentaA, _cuentaA, 50m, "pago", "prueba"));
+    }
+
+    [Fact]
+    public void BuscarCuentaPorNumero_EncuentraLaCuentaSinImportarMayusculas()
+    {
+        var encontrada = _servicio.BuscarCuentaPorNumero("cta-000002");
+
+        Assert.NotNull(encontrada);
+        Assert.Equal(_cuentaB.Id, encontrada!.Id);
+    }
+}
