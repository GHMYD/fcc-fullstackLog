+using System.Text.Json;
+
+namespace BankingSystem.Datos;
+
+/// <summary>
+/// Repositorio genérico en memoria respaldado por un archivo JSON.
+/// Provee las operaciones CRUD base (Crear, Leer, Actualizar, Eliminar)
+/// para cualquier entidad con un campo "Id".
+/// </summary>
+public class AlmacenJson<T> where T : class
+{
+    private readonly string _rutaArchivo;
+    private readonly List<T> _elementos;
+    private static readonly JsonSerializerOptions OpcionesJson = new()
+    {
+        WriteIndented = true
+    };
+
+    public AlmacenJson(string rutaArchivo)
+    {
+        _rutaArchivo = rutaArchivo;
+        _elementos = CargarDesdeDisco();
+    }
+
+    private List<T> CargarDesdeDisco()
+    {
+        if (!File.Exists(_rutaArchivo))
+        {
+            return new List<T>();
+        }
+
+        var contenido = File.ReadAllText(_rutaArchivo);
+        if (string.IsNullOrWhiteSpace(contenido))
+        {
+            return new List<T>();
+        }
+
+        return JsonSerializer.Deserialize<List<T>>(contenido, OpcionesJson) ?? new List<T>();
+    }
+
+    private void GuardarEnDisco()
+    {
+        var directorio = Path.GetDirectoryName(_rutaArchivo);
+        if (!string.IsNullOrEmpty(directorio))
+        {
+            Directory.CreateDirectory(directorio);
+        }
+
+        var json = JsonSerializer.Serialize(_elementos, OpcionesJson);
+        File.WriteAllText(_rutaArchivo, json);
+    }
+
+    public IReadOnlyList<T> ObtenerTodos() => _elementos.AsReadOnly();
+
+    public T? BuscarPor(Func<T, bool> predicado) => _elementos.FirstOrDefault(predicado);
+
+    public IEnumerable<T> BuscarTodosPor(Func<T, bool> predicado) => _elementos.Where(predicado);
+
+    public void Agregar(T elemento)
+    {
+        _elementos.Add(elemento);
+        GuardarEnDisco();
+    }
+
+    public void Actualizar()
+    {
+        // Los objetos se modifican por referencia; esto persiste el estado actual.
+        GuardarEnDisco();
+    }
+
+    public bool Eliminar(T elemento)
+    {
+        var eliminado = _elementos.Remove(elemento);
+        if (eliminado)
+        {
+            GuardarEnDisco();
+        }
+        return eliminado;
+    }
+}
